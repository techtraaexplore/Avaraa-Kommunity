# Copy this file to ".env" and fill it in. Never commit ".env".

# Password for the admin panel at /admin  (required, pick something long)
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign admin login tokens. Any long random string.
# If you leave it empty, a random one is made at start-up (everyone gets logged out on each restart).
TOKEN_SECRET=

# Port the server listens on
PORT=4000

# Where content.json, enquiries.json and uploaded photos are stored.
# Point this at a persistent disk/volume when you deploy.
# DATA_DIR=./server/data
# UPLOAD_DIR=./server/uploads

# Largest video you can upload in the admin (MB). If you use nginx, also set client_max_body_size.
# MAX_VIDEO_MB=200
